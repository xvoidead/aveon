{
  "name": "aveon",
  "productName": "авеон",
  "version": "1.4.0",
  "description": "Музыкальный плеер: когда в звонке Discord говорят, музыка уходит «в бочку»",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis",
    "mobile:build": "node mobile/build.mjs && cap sync android"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@noble/hashes": "^2.4.0",
    "buffer": "^6.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "path-browserify": "^1.0.1"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@fontsource/unbounded": "^5.3.0",
    "hls.js": "^1.7.3",
    "music-metadata": "^11.16.1"
  },
  "build": {
    "appId": "com.aveon.player",
    "productName": "авеон",
    "executableName": "aveon",
    "copyright": "MIT",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "native/**/*",
      "renderer/**/*",
      "!renderer/mobile.*",
      "!renderer/native.js"
    ],
    "asarUnpack": [
      "native/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "protocols": [
      {
        "name": "авеон",
        "schemes": [
          "aveon"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "авеон",
      "uninstallDisplayName": "авеон",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "aveon-setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
